# Every setting the project reads. Copy this file to .env and fill in the values.
# .env is git-ignored. Never commit real keys, and never paste them into docs or chat.

# --- Metabase (D-15, D-16) -------------------------------------------------
# Base URL of SolarSquare's Metabase, no trailing slash, e.g. https://metabase.yourcompany.com
METABASE_URL=
# API key created by a Metabase admin (Admin settings > API Keys). Read-only group access is enough.
METABASE_API_KEY=

# --- Google Sheets (Config sheet D-44, Pan India CT reasons D-48) --------------
# Path to the service account JSON key (keep it in secrets/, which is git-ignored). Setup: docs/config-sheet/service-account-setup.md
GOOGLE_SERVICE_ACCOUNT_FILE=
# ID part of the Config Google Sheet URL (docs.google.com/spreadsheets/d/<ID>/...)
CONFIG_SHEET_ID=
# Pan India Commissioning sheet (CT Working > Sub-Reasons)
PAN_INDIA_SHEET_ID=

# --- Live link (D-89, docs/deploy/cloudflare.md) ---------------------------------
# Cloudflare Pages project name; the site is https://<name>.pages.dev (used by pipeline/tools/build_site.py --deploy)
CF_PAGES_PROJECT=
